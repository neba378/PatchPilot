# PatchPilot Environment Configuration

# App
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development
ADMIN_PASSWORD=admin-secure-password-change-me

# Security & Secrets
# 32-byte hex key for AES-256-GCM encryption at rest (generate: openssl rand -hex 32)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CRON_SECRET=cron-super-secret-key-12345

# Database (SQLite file)
DATABASE_URL=data/patchpilot.sqlite

# Google Gemini (Free tier from ai.google.dev)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_RPM=10
GEMINI_RPD=250

# GitHub
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=github-webhook-secret-token

# Sentry
SENTRY_WEBHOOK_SECRET=sentry-webhook-secret-token

# Generic Webhook
GENERIC_WEBHOOK_SECRET=generic-webhook-secret-token

# Telegram Bot (Free from @BotFather)
TELEGRAM_BOT_TOKEN=

# Slack & Discord (Optional)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=

# Sandbox Provider (fake | local-docker | daytona | e2b)
SANDBOX_PROVIDER=fake
DAYTONA_API_KEY=
E2B_API_KEY=

# Recurrence Watch Window (in minutes; 1440 for 24h, default 5 for testing/demo)
RECURRENCE_WINDOW_MINUTES=5
